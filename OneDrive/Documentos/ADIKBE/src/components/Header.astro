---
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/quienes-somos/', label: 'Quiénes Somos' },
  { href: '/ejes-de-trabajo/', label: 'Ejes de Trabajo' },
  { href: '/equipo-y-aliados/', label: 'Equipo y Aliados' },
  { href: '/blog/', label: 'Blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <picture>
        <source srcset="/LogoSinFondo.webp" type="image/webp" />
        <img src="/LogoSinFondo.png" alt="ADIKB'E — Nuevo camino" class="brand__logo" />
      </picture>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
      <span></span>
    </label>

    <nav class="site-nav">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={currentPath === item.href ? 'is-active' : ''}
        >
          {item.label}
        </a>
      ))}
      <a href="/contacto/" class="btn btn--primary btn--nav">Donar / Contacto</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-cream-dark);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none !important;
  }
  .brand__logo {
    height: 52px;
    width: auto;
    display: block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .site-nav a {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a.is-active {
    color: var(--color-green-700);
    font-weight: 600;
  }
  .btn--nav {
    padding: 0.6rem 1.3rem;
  }

  .nav-toggle,
  .nav-toggle-label {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-toggle-label {
      display: flex;
      cursor: pointer;
      width: 36px;
      height: 30px;
      flex-direction: column;
      justify-content: center;
    }
    .nav-toggle-label span,
    .nav-toggle-label span::before,
    .nav-toggle-label span::after {
      content: '';
      display: block;
      height: 3px;
      border-radius: 2px;
      background: var(--color-green-900);
      position: relative;
      transition: 0.2s;
    }
    .nav-toggle-label span::before { top: -9px; }
    .nav-toggle-label span::after { top: 6px; }

    .site-nav {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      padding-top: 1rem;
      gap: 1rem;
    }
    .nav-toggle:checked ~ .site-nav {
      display: flex;
    }
    .btn--nav { margin-top: 0.5rem; }
  }
</style>
