---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { buildSrcset, webpSrc } from '../../utils/images';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog"
  description="Actualizaciones de los proyectos de reforestación, agroecología y desarrollo comunitario de ADIKB'E en la RUMCLA, Sololá."
>
  <section class="section section--tight hero-page">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1>Actualizaciones desde el territorio</h1>
      <p class="section-lead">
        Aquí compartimos, con transparencia, los avances de nuestros
        proyectos para que puedan seguir
        de cerca nuestro trabajo.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p>Muy pronto compartiremos aquí nuestras primeras actualizaciones.</p>
      ) : (
        <div class="grid grid--3">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="card post-card">
              {post.data.image && (
                <picture>
                  <source
                    srcset={buildSrcset(post.data.image, 'webp') ?? webpSrc(post.data.image)}
                    sizes="(max-width: 650px) 100vw, (max-width: 900px) 50vw, 360px"
                    type="image/webp"
                  />
                  <img
                    src={post.data.image}
                    srcset={buildSrcset(post.data.image, 'original')}
                    sizes="(max-width: 650px) 100vw, (max-width: 900px) 50vw, 360px"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class:list={['post-card__image', post.data.image === '/LogoSinFondo.png' && 'post-card__image--logo']}
                  />
                </picture>
              )}
              <div class="post-card__body">
                {post.data.eje && <span class="tag">{post.data.eje}</span>}
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="post-card__date">
                  {post.data.pubDate.toLocaleDateString('es-GT', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .section-lead {
    max-width: 680px;
    color: var(--color-text-muted);
  }
  .post-card {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .post-card:hover { text-decoration: none; transform: translateY(-3px); transition: transform 0.15s ease; }
  .post-card picture {
    display: block;
    width: 100%;
  }
  .post-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .post-card__image--logo {
    object-fit: contain;
    background: var(--color-cream-dark);
    padding: 1.5rem;
  }
  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.75rem 1.75rem;
    flex: 1;
  }
  .post-card__date {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: auto;
  }
</style>
