---
import Layout from '../layouts/Layout.astro';

const formasDeApoyo = [
  {
    titulo: 'Donación',
    texto: 'Cada recurso recibido es una responsabilidad con las comunidades que acompañamos. Escríbenos y te compartimos los datos para hacer tu donación (transferencia, depósito o en especie).',
  },
  {
    titulo: 'Voluntariado',
    texto: 'Súmate con tu tiempo y conocimiento a nuestras jornadas de reforestación, capacitaciones o proyectos de agroecología.',
  },
  {
    titulo: 'Alianza institucional',
    texto: '¿Representas una organización, fondo o cooperante? Conversemos sobre cómo trabajar juntos en la RUMCLA.',
  },
];
---

<Layout
  title="Contacto y Donaciones"
  description="Contáctanos para donar, ser voluntario o aliarte institucionalmente con ADIKB'E en Sololá, Guatemala."
>
  <section class="section section--tight hero-page">
    <div class="container">
      <span class="eyebrow">Súmate</span>
      <h1>Apoya nuestra causa ambiental</h1>
      <p class="section-lead">
        Además de mantenerte informado sobre nuestras capacitaciones y
        proyectos, puedes apoyarnos con una donación o ponerte en contacto si
        te interesa colaborar con nuestra causa ambiental.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {formasDeApoyo.map((f) => (
          <div class="card">
            <h3>{f.titulo}</h3>
            <p>{f.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container contact-grid">
      <div class="contact-info">
        <span class="eyebrow">Escríbenos</span>
        <h2>Hablemos</h2>
        <p>
          Completa el formulario y te responderemos por correo o teléfono.
          También puedes contactarnos directamente:
        </p>
        <ul class="contact-details">
          <li><strong>Correo:</strong> <a href="mailto:asociacionkakbe@gmail.com">asociacionkakbe@gmail.com</a></li>
          <li><strong>Teléfono:</strong> +502 4646 1825</li>
          <li>
            <strong>Dirección:</strong> Sector 1, Aldea María Tecún Alayo, zona 0,
            municipio de Sololá, Guatemala (Km. 137.5, Carretera Interamericana)
          </li>
        </ul>
      </div>

      <div class="card form-card">
        <form id="contact-form">
          <input type="hidden" name="access_key" value="6535e85e-16e7-496c-aac4-df160a43d397" />
          <input type="hidden" name="subject" value="Nuevo mensaje desde el sitio web de ADIKB'E" />
          <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

          <label for="name">Nombre completo</label>
          <input type="text" id="name" name="name" required />

          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" required />

          <label for="phone">Teléfono (opcional)</label>
          <input type="tel" id="phone" name="phone" />

          <label for="interes">Me interesa</label>
          <select id="interes" name="interes">
            <option>Hacer una donación</option>
            <option>Ser voluntario/a</option>
            <option>Alianza institucional</option>
            <option>Recibir información sobre capacitaciones</option>
            <option>Otro</option>
          </select>

          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="4" required></textarea>

          <button type="submit" class="btn btn--primary">Enviar mensaje</button>
          <p id="form-status" role="status"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-lead {
    max-width: 680px;
    color: var(--color-text-muted);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-details {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .form-card form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-card label {
    font-weight: 600;
    font-size: 0.88rem;
    margin-top: 0.7rem;
    color: var(--color-green-900);
  }
  .form-card input:not([type='checkbox']),
  .form-card select,
  .form-card textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--color-cream-dark);
    background: var(--color-cream);
    color: var(--color-text);
  }
  .form-card button {
    margin-top: 1.25rem;
    align-self: flex-start;
  }
  .honeypot {
    display: none;
  }
  #form-status {
    font-size: 0.9rem;
    margin-top: 0.75rem;
    min-height: 1.2em;
  }
  #form-status[data-state='success'] { color: var(--color-green-700); }
  #form-status[data-state='error'] { color: #b3261e; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const formData = new FormData(form);
    status.textContent = 'Enviando...';
    status.removeAttribute('data-state');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = '¡Gracias! Recibimos tu mensaje y te contactaremos pronto.';
        status.setAttribute('data-state', 'success');
        form.reset();
      } else {
        status.textContent = 'No pudimos enviar tu mensaje. Intenta de nuevo o escríbenos directamente a asociacionkakbe@gmail.com.';
        status.setAttribute('data-state', 'error');
      }
    } catch (error) {
      status.textContent = 'No pudimos enviar tu mensaje. Intenta de nuevo o escríbenos directamente a asociacionkakbe@gmail.com.';
      status.setAttribute('data-state', 'error');
    }
  });
</script>
